<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.quinceye.app">

    <application
        android:allowBackup="true"
        android:label="Quinc-Eye"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuincEye">
        <activity android:name=".ui.DashboardActivity" />
        <activity android:name=".ui.SaleActivity" />
        <activity android:name=".ui.ClientDetailActivity" />
        <activity android:name=".ui.clients.ClientListActivity" />
        <activity android:name=".ui.ProductDetailActivity" />
        <activity android:name=".ui.ProductListActivity" />
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
